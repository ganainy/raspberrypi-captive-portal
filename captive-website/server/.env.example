# Database configuration (replace with your actual credentials)
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=[YOUR_DB_PASSWORD]
DB_NAME=captive_portal

# HTTPS configuration (replace with your domain and paths)
HTTPS_KEY_PATH=/path/to/your/privkey.pem
HTTPS_CERT_PATH=/path/to/your/fullchain.pem

# API Port 
PORT=3000
