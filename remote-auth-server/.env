# Database configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=[YOUR_db_PASSWORD] # Replace with your actual password
DB_NAME=captive_portal

# HTTPS configuration (Original paths from code)
HTTPS_KEY_PATH=/etc/letsencrypt/live/[YOUR_DOMAIN]/privkey.pem # Replace [YOUR_DOMAIN]
HTTPS_CERT_PATH=/etc/letsencrypt/live/[YOUR_DOMAIN]/fullchain.pem # Replace [YOUR_DOMAIN]

# API Port
PORT=4000