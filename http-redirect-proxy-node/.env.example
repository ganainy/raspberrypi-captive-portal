# IP address the proxy should listen on
PROXY_LISTEN_IP=192.168.1.1

# Port the proxy should listen on
PROXY_LISTEN_PORT=8080

# URL of the remote login page (where users are redirected)
CAPTIVE_PORTAL_TARGET_URL=http:/your_captive_domain/login.html

# Domain name used for captive portal detection checks and redirection target
CAPTIVE_DOMAIN=your_captive_domain.com

# URL of the actual backend server where requests to CAPTIVE_DOMAIN are proxied
CAPTIVE_BACKEND_TARGET=http://your_backend_server_ip_or_domain

# Interface used for MAC address lookup (e.g., wlan0, eth1)
WLAN_INTERFACE=wlan0


