# Port the listener service will run on (should match the SSH tunnel destination port)
LISTENER_PORT=4001

# Path to the SQLite database file
DB_PATH=./sessions.db

# Session duration in milliseconds (e.g., 3600000 for 1 hour)
SESSION_DURATION_MS=3600000

# Interval for checking expired sessions in milliseconds (e.g., 60000 for 1 minute)
CHECK_INTERVAL_MS=60000

# IPTables configuration
WLAN_INTERFACE=wlan0
REDIRECT_TARGET_IP=192.168.1.1
REDIRECT_TARGET_PORT=8080
